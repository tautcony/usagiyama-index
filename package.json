{
  "name": "usagiyama-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "「兔子山的小站」内容归档站点",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "sync": "uv run python -m scraper.cli sync",
    "sync:dry": "uv run python -m scraper.cli sync --dry-run",
    "emit": "uv run python -m scraper.cli emit",
    "report": "uv run python -m scraper.cli report",
    "login": "uv run python -m scraper.cli login",
    "login:check": "uv run python -m scraper.cli login --check",
    "verify": "uv run python -m scraper.cli verify",
    "test": "uv run python -m pytest scraper/tests -q"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  }
}
